# Copy to `.env` and fill in the values for your Firebase project.
# `.env` is gitignored, so it must never be committed.
#
# Values come from the Firebase console (Project settings > Your apps) and, for
# Android, from android/app/google-services.json.

# --- Android (required for `flutter run` on Android) ---
ANDROID_API_KEY=
ANDROID_APP_ID=
ANDROID_MESSAGING_SENDER_ID=
ANDROID_PROJECT_ID=
ANDROID_STORAGE_BUCKET=

# --- Google Sign-In (serverClientId, the "Web client" OAuth client ID) ---
GOOGLE_WEB_CLIENT_ID=

# --- Web ---
WEB_API_KEY=
WEB_APP_ID=
WEB_MESSAGING_SENDER_ID=
WEB_PROJECT_ID=
WEB_AUTH_DOMAIN=
WEB_STORAGE_BUCKET=

# --- iOS ---
IOS_API_KEY=
IOS_APP_ID=
IOS_MESSAGING_SENDER_ID=
IOS_PROJECT_ID=
IOS_STORAGE_BUCKET=
IOS_CLIENT_ID=
IOS_BUNDLE_ID=

# --- macOS ---
MACOS_API_KEY=
MACOS_APP_ID=
MACOS_MESSAGING_SENDER_ID=
MACOS_PROJECT_ID=
MACOS_STORAGE_BUCKET=
MACOS_CLIENT_ID=
MACOS_BUNDLE_ID=

# --- Windows ---
WINDOW_API_KEY=
WINDOW_APP_ID=
WINDOW_MESSAGING_SENDER_ID=
WINDOW_PROJECT_ID=
WINDOW_AUTH_DOMAIN=
WINDOW_STORAGE_BUCKET=
